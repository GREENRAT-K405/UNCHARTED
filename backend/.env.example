# MongoDB: Atlas cluster URI, or the local atlas container from docker-compose.yml
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=pehchaan

# Claude (memory agent + brief writer). Leave unset to run the offline rule-based agent.
ANTHROPIC_API_KEY=
# Free Groq key (console.groq.com/keys). When set, the memory agent uses Groq instead of Claude.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_MODE=auto        # auto | groq | claude | offline
# CLAUDE_MODEL=claude-opus-5-5

# Voyage AI embeddings (voyage-3.5, 1024 dims). Unset -> local hashed embeddings.
# VOYAGE_BASE_URL=https://ai.mongodb.com/v1   # set this if the key came from Atlas Model API Keys
VOYAGE_API_KEY=

TIMEZONE=Asia/Kolkata
# Base URL used for receiver join links (use your LAN IP for a two-laptop demo)
PUBLIC_BASE_URL=http://localhost:5173

# Firebase Auth: the project id is all the backend needs to verify sign-in tokens
# (no service-account key). Leave unset for local "dev" auth mode.
FIREBASE_PROJECT_ID=
