# Firebase web app config: Firebase Console -> Project settings -> Your apps -> Web app.
# These values are public identifiers (safe in a browser), not secrets.
# Leave VITE_FIREBASE_API_KEY empty to use local dev sign-in instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
